{
  "name": "@campus-infra/global-calendar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "fic:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/fic-seed.ts",
    "seed:all": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts && ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/fic-seed.ts",
    "seed:service-keys": "TS_NODE_TRANSPILE_ONLY=true ts-node --skip-project --compiler-options '{\"module\":\"CommonJS\"}' prisma/dev-service-keys.ts",
    "import:iitgn": "npx ts-node scripts/import-iitgn-events.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fullcalendar/core": "^5.11.5",
    "@fullcalendar/daygrid": "^5.11.5",
    "@fullcalendar/interaction": "^5.11.5",
    "@fullcalendar/react": "^5.11.5",
    "@fullcalendar/rrule": "^5.11.5",
    "@fullcalendar/timegrid": "^5.11.5",
    "@prisma/client": "^5.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "14.2.0",
    "next-auth": "^4.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.36.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.0",
    "postcss": "^8.5.28",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
